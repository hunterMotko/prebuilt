PORT=8080

# SMTP — used to email contact form submissions
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# Where form submissions are emailed
CONTACT_EMAIL=owner@prebuiltsheds.com

# Management panel — HTTP Basic Auth
ADMIN_USER=admin
ADMIN_PASS=

# URL prefix the panel mounts at. Leading slash, no trailing one; unset falls
# back to /admin.
#
# Set this to something unguessable in production and leave it out of the repo.
# It stops blind scanners filling the logs and tripping the fail2ban jail; it is
# not a security control, and the password, rate limit, and CSRF are what stop
# anyone who finds the path. Changing it invalidates existing CSRF cookies, so
# an open admin tab needs one reload.
#
# Two things must match whatever you set here: the fail2ban filter's failregex
# (deploy/fail2ban/filter.d/prebuilt-admin.conf) and your own bookmark.
ADMIN_PATH=/admin

# ─── Feature flags ────────────────────────────────────────────────────────────
# Unfinished features are OFF unless explicitly enabled, so nothing half-built
# can reach production by accident. When a flag is off the routes aren't
# registered at all (the page 404s) and its nav/footer links don't render.

# The public /instock inventory page and its "Ask About This One" form.
# Turn on locally while working on it; leave unset in production until it ships.
# The /admin inventory screens are NOT gated by this — they stay available so
# real stock can be entered before the public page goes live.
# FEATURE_INSTOCK=true

# ─── Deployment only ──────────────────────────────────────────────────────────
# Leave all three unset for local development; docker-compose.yml sets them.

# Where the SQLite file lives. Must be a directory the app can write, because
# SQLite puts its journal sidecar files alongside the database.
# Unset = ./prebuilt.db
# DB_PATH=/data/prebuilt.db

# Set to true ONLY when a reverse proxy (nginx on the VPS) is in front,
# so the per-IP rate limiter reads the real client IP from X-Forwarded-For
# instead of seeing every request as coming from the proxy. Leaving it on with
# no proxy would let a client spoof its IP via that header.
# TRUST_PROXY=true

# Set to true once the site is served over HTTPS — marks the admin CSRF cookie
# Secure. Must stay false on plain HTTP or the browser drops the cookie and
# admin logins break.
# COOKIE_SECURE=true

# Emit the Content-Security-Policy as report-only instead of enforcing it.
# A CSP mistake fails silently — the browser refuses to run the blocked script
# and nothing is logged server-side — so set this on the first deploy after a
# policy change, click through every page with devtools open, then unset it.
# CSP_REPORT_ONLY=true

# Public origin, no trailing slash — e.g. https://prebuiltshedsllc.com
# Required for canonical links and Open Graph / Twitter Card tags, which must
# carry absolute URLs. When unset, those tags are omitted entirely rather than
# emitted with a broken origin: a canonical pointing nowhere actively tells
# search engines the real page lives somewhere it doesn't.
# SITE_URL=https://prebuiltshedsllc.com
